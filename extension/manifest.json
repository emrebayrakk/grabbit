{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0.3",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["contextMenus", "downloads", "cookies", "storage", "notifications", "scripting", "webRequest", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["sites.js", "i18n.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grabbit",
    "default_icon": { "32": "icon32.png", "128": "icon128.png" }
  },
  "icons": { "32": "icon32.png", "128": "icon128.png" }
}
