{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grabbit",
  "version": "3.0.0",
  "identifier": "com.turboindir.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Emre Bayrak",
    "copyright": "© 2026 Emre Bayrak",
    "category": "Utility",
    "shortDescription": "Fast download manager",
    "longDescription": "Multi-connection downloads, resume, browser integration, YouTube & social media videos, HLS streams and full-size images.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../extension/": "extension/",
      "../assets/tray.png": "tray.png"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish", "German", "Spanish", "French", "Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer.nsh"
      }
    }
  }
}
